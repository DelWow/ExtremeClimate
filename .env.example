# Local development defaults only. Do not reuse this password outside local development.
POSTGRES_DB=extreme_climate
POSTGRES_USER=extreme_climate
POSTGRES_PASSWORD=extreme_climate_dev
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

# Kafka host-client settings. Compose services should use kafka:19092 instead.
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_TOPIC=weather
KAFKA_CLIENT_ID=extreme-climate-weather-producer
KAFKA_DELIVERY_TIMEOUT_SECONDS=30
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CONSUMER_GROUP_ID=extreme-climate-raw-weather
KAFKA_CONSUMER_CLIENT_ID=extreme-climate-weather-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_SECONDS=1

# Weather provider endpoint.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REGIONS_CONFIG_PATH=config/regions.yaml

# Airflow local-development settings. The metadata database is isolated from
# the application database above. Change these credentials outside local use.
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev
AIRFLOW_DATABASE_URL=postgresql+psycopg2://airflow:airflow_dev@airflow-postgres/airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow_dev
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=airflow@example.invalid

# Reports created by the Airflow DAG are written to the mounted reports folder.
REPORT_OUTPUT_DIR=/opt/airflow/project/reports

# For authenticated Kafka clusters, select SASL_PLAINTEXT or SASL_SSL above
# and provide credentials in the untracked .env file or process environment.
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=
